<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GreenRoots Landscaping Co. - Service Enquiry</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Open+Sans:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="styles/styles.css">
    <style>
        #page-hero {
            background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('images/misc/enquiry-hero.jpg');
            background-size: cover;
            background-position: center;
            padding: 6rem 0;
        }
        
        .enquiry-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem;
            background-color: var(--light-gray);
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        .enquiry-info {
            background-color: var(--white);
            padding: 2rem;
            border-radius: 8px;
            margin-bottom: 2rem;
        }
        
        .enquiry-info h3 {
            color: var(--forest-green);
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <header>
        <div class="container header-container">
            <div class="logo">GreenRoots Landscaping Co.</div>
            <button class="mobile-menu-btn" id="mobile-menu">
                <i class="fas fa-bars"></i>
            </button>
            <nav>
                <ul class="nav-menu" id="nav-menu">
                    <li><a href="index.html">Home</a></li>
                    <li><a href="aboutus.html">About</a></li>
                    <li><a href="services.html">Services</a></li>
                    <li><a href="gallery.html">Gallery</a></li>
                    <li><a href="contact.html">Contact</a></li>
                    <li><a href="enquiry.html" class="active">Enquire</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <section id="page-hero">
            <div class="container">
                <h1>Service Enquiry</h1>
                <p>Get detailed quotes and availability for our landscaping services</p>
            </div>
        </section>

        <section class="section">
            <div class="container">
                <div class="section-title">
                    <h2>Request a Quote</h2>
                    <p>Tell us about your project and we'll provide you with cost details and availability</p>
                </div>
                
                <div class="enquiry-container">
                    <div class="enquiry-info">
                        <h3>What to Expect</h3>
                        <p>After submitting your enquiry, our team will:</p>
                        <ul>
                            <li>Review your project requirements within 24 hours</li>
                            <li>Provide detailed cost estimates based on your specific needs</li>
                            <li>Check availability for your preferred timeline</li>
                            <li>Schedule a free consultation if needed</li>
                            <li>Offer sustainable alternatives and recommendations</li>
                        </ul>
                    </div>
                    
                    <form id="enquiryForm" data-form="enquiry">
                        <!-- === PART 3 ADDITION - SUCCESS MESSAGE === -->
                        <div class="success-message" style="display: none;"></div>
                        <!-- === END PART 3 ADDITION === -->
                        
                        <div class="form-group">
                            <label for="enquiry-name">Full Name *</label>
                            <input type="text" id="enquiry-name" name="name" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="enquiry-email">Email Address *</label>
                            <input type="email" id="enquiry-email" name="email" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="enquiry-phone">Phone Number *</label>
                            <input type="tel" id="enquiry-phone" name="phone" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="enquiry-address">Property Address</label>
                            <input type="text" id="enquiry-address" name="address" placeholder="Street, Suburb, City">
                        </div>
                        
                        <div class="form-group">
                            <label for="enquiry-service">Service Required *</label>
                            <select id="enquiry-service" name="service" required>
                                <option value="">Select a service</option>
                                <option value="garden-design">Garden Design & Planning</option>
                                <option value="maintenance">Garden Maintenance</option>
                                <option value="eco-solutions">Eco-Friendly Solutions</option>
                                <option value="lawn-care">Lawn Care</option>
                                <option value="irrigation">Irrigation Systems</option>
                                <option value="seasonal">Seasonal Cleanup</option>
                                <option value="multiple">Multiple Services</option>
                                <option value="not-sure">Not Sure - Need Advice</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="enquiry-budget">Estimated Budget</label>
                            <select id="enquiry-budget" name="budget">
                                <option value="">Select budget range</option>
                                <option value="under-5000">Under R5,000</option>
                                <option value="5000-15000">R5,000 - R15,000</option>
                                <option value="15000-30000">R15,000 - R30,000</option>
                                <option value="30000-50000">R30,000 - R50,000</option>
                                <option value="over-50000">Over R50,000</option>
                                <option value="not-sure">Need quote first</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="enquiry-timeline">Preferred Timeline</label>
                            <select id="enquiry-timeline" name="timeline">
                                <option value="">Select timeline</option>
                                <option value="asap">As soon as possible</option>
                                <option value="1-month">Within 1 month</option>
                                <option value="3-months">Within 3 months</option>
                                <option value="6-months">Within 6 months</option>
                                <option value="flexible">Flexible</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="enquiry-area">Approximate Area Size</label>
                            <input type="text" id="enquiry-area" name="area" placeholder="e.g., 100m², small backyard, large garden">
                        </div>
                        
                        <div class="form-group">
                            <label for="enquiry-description">Project Description *</label>
                            <textarea id="enquiry-description" name="description" rows="6" required placeholder="Please describe your project in detail. Include any specific requirements, challenges, or vision you have for your outdoor space..."></textarea>
                        </div>
                        
                        <div class="form-group">
                            <label>
                                <input type="checkbox" name="newsletter" checked>
                                Send me updates about sustainable landscaping tips and special offers
                            </label>
                        </div>
                        
                        <button type="submit" class="btn submit-btn">Submit Enquiry</button>
                    </form>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <div class="footer-content">
                <p>Ready to start your landscaping project? We're here to help!</p>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-pinterest-p"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                </div>
                <p>© 2023 GreenRoots Landscaping Co. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="j.s/script.js"></script>
</body>
</html>